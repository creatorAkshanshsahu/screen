{
  "manifest_version": 2,
  "name": "AKTV TG player fix",
  "version": "1.0",
  "description": "Forces the TG embed player to start, unmute-retry and reload itself when it stalls.",
  "browser_specific_settings": { "gecko": { "id": "tgfix@aktv.app" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
