<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/abyss">

    <!-- living backdrop -->
    <com.aktv.app.AuroraView android:id="@+id/aurora" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_left"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_bottom"/>

    <LinearLayout android:id="@+id/home" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingTop="22dp">

        <!-- top bar -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginStart="56dp" android:layout_marginEnd="56dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                android:layout_gravity="start" android:gravity="center_vertical">
                <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_mark"/>
                <TextView android:id="@+id/brandText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="AKtv" android:textColor="@color/text"
                    android:textSize="19sp" android:fontFamily="@font/sora_bold" android:letterSpacing="0.02"/>
            </LinearLayout>

            <FrameLayout android:id="@+id/segTrack" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical" android:layout_marginStart="150dp" android:padding="4dp">
                <View android:id="@+id/segIndicator" android:layout_width="0dp" android:layout_height="match_parent"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/segLive" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Live TV" android:focusable="true" android:clickable="true"
                        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="9dp" android:paddingBottom="9dp"
                        android:textSize="15sp" android:fontFamily="@font/sora_semibold"/>
                    <TextView android:id="@+id/seg247" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="24/7" android:focusable="true" android:clickable="true"
                        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="9dp" android:paddingBottom="9dp"
                        android:textSize="15sp" android:fontFamily="@font/sora_semibold"/>
                    <TextView android:id="@+id/segSites" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Movies &amp; series" android:focusable="true" android:clickable="true"
                        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="9dp" android:paddingBottom="9dp"
                        android:textSize="15sp" android:fontFamily="@font/sora_semibold"/>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                android:layout_gravity="end" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/btnSearch" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Search" android:focusable="true" android:clickable="true"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textColor="@color/text_dim" android:textSize="13sp" android:fontFamily="@font/sora_semibold"/>
                <TextView android:id="@+id/versionV2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="V2  ↗" android:focusable="true" android:clickable="true"
                    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="7dp"
                    android:textColor="@color/text" android:textSize="12sp" android:fontFamily="@font/sora_semibold"
                    android:background="@drawable/live_pill"/>
                <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="18dp" android:format12Hour="h:mm" android:format24Hour="HH:mm"
                    android:textColor="@color/text_dim" android:textSize="17sp" android:fontFamily="@font/sora_regular"/>
            </LinearLayout>
        </FrameLayout>

        <!-- hero: driven by whatever is focused -->
        <FrameLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="214dp"
            android:layout_marginStart="56dp" android:layout_marginEnd="56dp">
            <LinearLayout android:id="@+id/heroText" android:layout_width="560dp" android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/heroDot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot"/>
                    <TextView android:id="@+id/heroBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:textColor="@color/text_dim" android:textSize="14sp"
                        android:fontFamily="@font/sora_semibold"/>
                </LinearLayout>
                <TextView android:id="@+id/heroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/text"
                    android:textSize="44sp" android:fontFamily="@font/sora_light" android:letterSpacing="-0.01"
                    android:includeFontPadding="false" android:lineSpacingMultiplier="0.95"/>
                <LinearLayout android:id="@+id/heroChips" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:orientation="horizontal"/>
            </LinearLayout>
            <View android:id="@+id/heroGlow" android:layout_width="260dp" android:layout_height="214dp"
                android:layout_gravity="end|center_vertical" android:layout_marginEnd="-18dp"/>
            <FrameLayout android:id="@+id/heroOrb" android:layout_width="176dp" android:layout_height="176dp"
                android:layout_gravity="end|center_vertical" android:layout_marginEnd="24dp">
                <ImageView android:id="@+id/heroLogo" android:layout_width="104dp" android:layout_height="104dp"
                    android:layout_gravity="center" android:scaleType="fitCenter"/>
                <TextView android:id="@+id/heroMono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:textColor="#FFFFFF" android:textSize="64sp"
                    android:fontFamily="@font/sora_bold" android:includeFontPadding="false" android:visibility="gone"/>
            </FrameLayout>
        </FrameLayout>

        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="56dp" android:textColor="@color/text_dim" android:textSize="13sp"/>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rows" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:paddingStart="52dp" android:paddingTop="4dp"
            android:paddingBottom="120dp" android:clipToPadding="false" android:clipChildren="false"
            android:overScrollMode="never" android:requiresFadingEdge="none" android:fadeScrollbars="false"/>
    </LinearLayout>

    <!-- player -->
    <FrameLayout android:id="@+id/playerLayer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#000000" android:keepScreenOn="true" android:visibility="gone">
        <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent"
            android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit"/>
        <View android:id="@+id/playerScrim" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/scrim_player" android:alpha="0"/>
        <LinearLayout android:id="@+id/infoCard" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:layout_margin="40dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:minWidth="420dp" android:paddingStart="16dp" android:paddingEnd="30dp"
            android:paddingTop="16dp" android:paddingBottom="16dp" android:alpha="0">
            <FrameLayout android:id="@+id/infoLogoBox" android:layout_width="64dp" android:layout_height="64dp">
                <ImageView android:id="@+id/infoLogo" android:layout_width="42dp" android:layout_height="42dp"
                    android:layout_gravity="center" android:scaleType="fitCenter"/>
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="18dp" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE"
                        android:background="@drawable/live_pill" android:textColor="#FFFFFF" android:textSize="10sp"
                        android:fontFamily="@font/sora_bold" android:letterSpacing="0.08" android:paddingStart="8dp"
                        android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
                    <TextView android:id="@+id/infoCat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:textColor="@color/text_dim" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:id="@+id/infoName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text"
                    android:textSize="24sp" android:fontFamily="@font/sora_semibold"/>
                <TextView android:id="@+id/infoNow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:maxWidth="560dp"
                    android:textColor="@color/text_dim" android:textSize="13sp" android:visibility="gone"/>
                <TextView android:id="@+id/infoHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textColor="@color/text_faint" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
        <TextClock android:id="@+id/playerClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="36dp" android:timeZone="Asia/Kolkata" android:format12Hour="hh:mm a" android:format24Hour="HH:mm"
            android:textColor="@color/text" android:textSize="20sp" android:fontFamily="@font/sora_semibold" android:alpha="1" android:elevation="8dp"
            android:shadowColor="#99000000" android:shadowRadius="12"/>
        <!-- channel guide: Right opens, Left goes back -->
        <View android:id="@+id/guideScrim" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/scrim_guide" android:visibility="gone"/>
        <LinearLayout android:id="@+id/guide" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:layout_gravity="end" android:layout_margin="24dp" android:orientation="horizontal" android:padding="12dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="250dp" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Categories"
                    android:paddingStart="14dp" android:paddingTop="10dp" android:paddingBottom="8dp"
                    android:textColor="@color/text_faint" android:textSize="13sp" android:fontFamily="@font/sora_semibold"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/catList" android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
                    android:paddingBottom="24dp" android:overScrollMode="never" android:requiresFadingEdge="none"/>
            </LinearLayout>
            <View android:id="@+id/guideDivider" android:layout_width="1dp" android:layout_height="match_parent"
                android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:layout_marginStart="8dp"
                android:background="#1FFFFFFF" android:visibility="gone"/>
            <LinearLayout android:id="@+id/chCol" android:layout_width="340dp" android:layout_height="match_parent"
                android:layout_marginStart="8dp" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/chHeader" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="12dp" android:paddingTop="10dp" android:paddingBottom="8dp"
                    android:textColor="@color/text_faint" android:textSize="13sp" android:fontFamily="@font/sora_semibold"/>
                <TextView android:id="@+id/chSearch" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="8dp"
                    android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:text="Search all channels" android:textColor="@color/text_dim" android:textSize="13sp"
                    android:fontFamily="@font/sora_regular" android:focusable="true" android:clickable="true"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/chList" android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
                    android:paddingBottom="24dp" android:overScrollMode="never" android:requiresFadingEdge="none"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/serverPanel" android:layout_width="300dp" android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical" android:layout_marginStart="40dp" android:orientation="vertical"
            android:padding="14dp" android:visibility="gone">
            <TextView android:id="@+id/serverTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="12dp" android:paddingTop="6dp" android:paddingBottom="10dp" android:text="Servers"
                android:textColor="@color/text_faint" android:textSize="13sp" android:fontFamily="@font/sora_semibold"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/serverList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:overScrollMode="never"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/spinner" android:layout_width="56dp" android:layout_height="56dp"
            android:layout_gravity="center" android:indeterminateTint="@color/ion"/>
    </FrameLayout>

    <!-- search -->
    <FrameLayout android:id="@+id/search" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#F4060812" android:visibility="gone" android:clickable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:layout_marginStart="56dp" android:layout_marginEnd="56dp"
            android:layout_marginTop="26dp" android:layout_marginBottom="26dp">
            <LinearLayout android:layout_width="372dp" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Search"
                    android:textColor="@color/text" android:textSize="26sp" android:fontFamily="@font/sora_semibold"/>
                <TextView android:id="@+id/searchQuery" android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:gravity="center_vertical"
                    android:paddingStart="18dp" android:paddingEnd="18dp" android:singleLine="true"
                    android:textColor="@color/text" android:textSize="18sp" android:fontFamily="@font/sora_regular"/>
                <LinearLayout android:id="@+id/kbd" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="36dp" android:orientation="vertical">
                <TextView android:id="@+id/searchHeader" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingTop="10dp" android:paddingBottom="10dp" android:paddingStart="12dp"
                    android:textColor="@color/text_faint" android:textSize="13sp" android:fontFamily="@font/sora_semibold"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/searchList" android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
                    android:paddingBottom="24dp" android:overScrollMode="never"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- intro -->
    <com.aktv.app.SplashView android:id="@+id/splash" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clickable="true"/>
</FrameLayout>
