<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:focusable="true" android:clickable="true" android:paddingStart="16dp" android:paddingEnd="16dp">
    <TextView android:id="@+id/srvName" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_dim"
        android:textSize="15sp" android:fontFamily="@font/sora_semibold"/>
    <TextView android:id="@+id/srvState" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:textColor="@color/ion" android:textSize="12sp"/>
</LinearLayout>
